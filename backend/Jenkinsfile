pipeline {
  agent any
  tools { nodejs 'node20' }   // nama NodeJS di Jenkins > Tools (Node 20 atau lebih baru)
  stages {
    stage('Install Backend') { steps { dir('backend') { sh 'npm ci || npm install' } } }
    stage('Test Backend')    { steps { dir('backend') { sh 'npm test' } } }
    stage('Install Frontend'){ steps { dir('frontend') { sh 'npm ci || npm install' } } }
    stage('Build Frontend')  { steps { dir('frontend') { sh 'npm run build' } } }
  }
  post {
    success { echo 'Build dan test berhasil' }
    failure { echo 'Pipeline gagal, cek log' }
  }
}
